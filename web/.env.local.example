# LabLog frontend — PUBLIC. Everything here is shipped to the browser.
# Only NEXT_PUBLIC_* names may appear. No service-role key, no AssemblyAI key,
# no JWT secret — see Constitution Principle III.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Guest mode: sign reviewers in automatically as a demo account, so the app
# works with no login. These reach the browser — use a throwaway account that
# owns only seeded data. Leave blank to require a real login.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
